# CAFI Wallet — Environment Configuration
# Salin file ini menjadi `.env.local` untuk development.

# RPC URL untuk koneksi read-only ke Ethereum Mainnet.
# Bisa pakai public RPC (https://eth.llamarpc.com, https://rpc.ankr.com/eth)
# atau Infura/Alchemy untuk produksi.
NEXT_PUBLIC_ETH_RPC_URL=https://eth.llamarpc.com

# (Opsional) Chain ID — default 1 = Ethereum Mainnet.
NEXT_PUBLIC_CHAIN_ID=1
